<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__Tab</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__RecordPage">
            <!-- Deprecated: unused since Employee Name navigation was removed. Kept because
                 Salesforce won't remove a property while the component is on a Lightning page. -->
            <property
                name="employeeAppUrl"
                type="String"
                label="(Deprecated) Employee App URL"
                description="No longer used."
            />
            <property
                name="openInNewTab"
                type="Boolean"
                default="false"
                label="(Deprecated) Open Employee App in new tab"
                description="No longer used."
            />
            <property name="appTitle" type="String" default="iBusiness" label="Header title" description="Title in the centre of the top bar." />
            <property name="brandName" type="String" default="Adviser Portal" label="Brand text" description="Shown in the header's logo area when no logo URL is set." />
            <property name="logoUrl" type="String" label="Logo URL" description="Optional logo image for the header, e.g. /resource/MyLogo." />
            <supportedFormFactors>
                <supportedFormFactor type="Large"/>
                <supportedFormFactor type="Small"/>
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
